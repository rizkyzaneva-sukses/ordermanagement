# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://orderpro:orderpro@localhost:5432/orderpro

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
ENCRYPTION_KEY=32-char-hex-key-here-change-this

# ── Shopee Open Platform ────────────────────────────────
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Push (webhook) URL registered in the Shopee Partner Console. Shopee includes
# this URL in the string it signs, so it must match the console entry character
# for character or every push is rejected as unsigned.
# Leave blank to derive it as <BACKEND_URL>/api/webhooks/shopee — set it only when
# the public URL differs from BACKEND_URL (e.g. a proxy rewrites the path).
SHOPEE_PUSH_URL=

# Live Push Partner Key — generated separately in Partner Console → Push
# Mechanism → Set Push. This is NOT the same value as SHOPEE_PARTNER_KEY: pushes
# are signed with this dedicated key, the main key only signs outgoing API calls.
SHOPEE_PUSH_PARTNER_KEY=

# ── TikTok Shop Open Platform ───────────────────────────
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# ── Container role ──────────────────────────────────────
# Which process this container runs. Same image either way.
#   api    (default) → migrations + HTTP server
#   worker           → BullMQ queue consumers, no HTTP
PROCESS_ROLE=api

# ── Server ──────────────────────────────────────────────
# The values below are for running on your own machine. In production these are
# set in the hosting panel's own environment settings (EasyPanel → Lingkungan),
# NOT from this file — nothing here is read by the deployed containers.
#
# In production both MUST be the public https:// origin, because they are not
# only used for links:
#
#   BACKEND_URL  builds the OAuth redirect sent to Shopee
#                (<BACKEND_URL>/api/oauth/shopee/callback, see routes/stores.js)
#                and, when SHOPEE_PUSH_URL is blank, the push URL as well.
#                Shopee signs the push URL, so it has to match the entry in the
#                Partner Console character for character or every push is
#                rejected as unsigned. A localhost value here means merchants
#                are redirected to their own machine after authorizing, and the
#                store is never connected.
#
#   FRONTEND_URL is where the OAuth callback sends the browser once the store is
#                saved (routes/oauth.js). Getting it wrong does not lose the
#                token — the store is already stored by then — but the merchant
#                lands on a dead page and assumes it failed.
PORT=3000
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# ── Generated files (batch PDFs, downloaded air waybills) ────
# Defaults to ./storage next to the app. When the API and the worker run as
# separate containers this MUST point at the same shared volume on both —
# the worker writes the batch PDF and the API serves it back.
STORAGE_DIR=

# Delete downloaded Shopee air waybills after this many days
AWB_RETENTION_DAYS=30

# ── Business timezone ────────────────────────────────────────
# Date filters arrive as a bare YYYY-MM-DD and are anchored to this offset, not
# to the server's own zone — a container without TZ set runs on UTC, which would
# shift every "hari ini" seven hours and drop the early-morning orders.
BUSINESS_UTC_OFFSET=+07:00
